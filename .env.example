# Gaid3 Environment — SERVER ONLY (never prefix AI keys with VITE_ / NEXT_PUBLIC_)
# These are read by Vercel Functions at runtime. Set them in Vercel Dashboard → Settings → Environment Variables

# Primary AI (recommended) — Groq Llama 3.3 70B
GROQ_API_KEY=gsk_...your_groq_key_here

# Fallback AIs (optional)
XAI_API_KEY=xai-...your_xai_key_here
GROK_API_KEY=xai-...alias_for_xai
GEMINI_API_KEY=AIza...your_gemini_key_here

# Walrus Protocol (Sui Testnet)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# zkLogin (Google OAuth → Sui address, no seed phrase) — SERVER-SIDE ONLY
# Get from Google Cloud Console → OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Enoki salt service (optional, for production zkLogin salt derivation) — server-side
ENOKI_API_KEY=enoki_private_...
# Open Notebook (llnovo/open-notebook) self-hosted integration — optional
# Run your own notebook instance and set these to unlock vector RAG, YouTube transcript
# ingestion, and Web3 doc simplification via notebook LLM features
OPEN_NOTEBOOK_URL=https://your-notebook-instance.com
OPEN_NOTEBOOK_PASSWORD=your_notebook_api_key
# YouTube Transcript API — used by /api/ingest for YouTube link processing
# (no key needed for public videos, but set YOUTUBE_API_KEY for private/unlisted)
YOUTUBE_API_KEY=
# SECURITY: Never commit real keys. Vercel env is server-only. Client bundle must NOT contain gsk_ / xai- keys.
