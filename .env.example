# Gaid3 Environment — SERVER ONLY (never prefix AI keys with VITE_ / NEXT_PUBLIC_)
# These are read by Vercel Functions at runtime. Set them in Vercel Dashboard → Settings → Environment Variables

# Primary AI (recommended) — Groq Llama 3.3 70B
GROQ_API_KEY=gsk_...your_groq_key_here

# Fallback AIs (optional)
XAI_API_KEY=xai-...your_xai_key_here
GROK_API_KEY=xai-...alias_for_xai
GEMINI_API_KEY=AIza...your_gemini_key_here

# Walrus Protocol (Sui Testnet)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Local dev server
PORT=3001
HOST=localhost
MEMWAL_MCP_ENABLED=true

# SECURITY: Never commit real keys. Vercel env is server-only. Client bundle must NOT contain gsk_ / xai- keys.
