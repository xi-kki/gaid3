{
  "name": "gaid3",
  "version": "1.0.0",
  "description": "A calm, patient, and highly practical Web3 Onboarding AI Agent powered by Walrus Memory.",
  "main": "dist/src/agent/core.js",
  "scripts": {
    "build": "tsc",
    "cli": "tsx src/cli/index.ts",
    "server": "tsx src/server/api.ts",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "dev": "concurrently \"tsx src/server/api.ts\" \"vite web\"",
    "mock:notebook": "node scripts/mock-open-notebook.mjs",
    "dev:notebook": "concurrently \"npm run mock:notebook\" \"tsx src/server/api.ts\" \"vite web\""
  },
  "keywords": [
    "web3",
    "ai-agent",
    "walrus",
    "sui",
    "memwal",
