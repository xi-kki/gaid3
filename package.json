  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "inquirer": "^9.3.2",
    "nanoid": "^5.0.7",
    "ora": "^8.0.1",
    "youtube-transcript": "^1.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.9",
